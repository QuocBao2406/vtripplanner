generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AppRole {
  USER
  PARTNER
  ADMIN
}

enum PartnerApprovalStatus {
  NOT_APPLIED
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum PartnerType {
  HOTEL
  HOMESTAY
  RESORT
  RESTAURANT
  EATERY
  CAFE
  ENTERTAINMENT_VENUE
  TOURIST_ATTRACTION
  TRANSPORT_PROVIDER
  RESCUE_SERVICE
  VEHICLE_REPAIR
  TRAVEL_SERVICE
  OTHER
}

enum PlaceVerificationStatus {
  DRAFT
  PENDING
  VERIFIED
  REJECTED
  SUSPENDED
}

enum TravelPace {
  RELAXED
  BALANCED
  ACTIVE
}

enum BudgetLevel {
  ECONOMY
  STANDARD
  PREMIUM
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum PlacePriceAudience {
  GENERAL
  ADULT
  CHILD
  INFANT
  SENIOR
  STUDENT
  GROUP
  OTHER
}

enum PlacePriceUnit {
  PERSON
  ENTRY
  HOUR
  DAY
  NIGHT
  ROOM
  VEHICLE
  TABLE
  PACKAGE
  OTHER
}

enum TripStatus {
  DRAFT
  PLANNING
  READY
  IN_PROGRESS
  COMPLETED
  CANCELLED
  ARCHIVED
}

enum ParticipantAgeGroup {
  ADULT
  CHILD
  INFANT
  SENIOR
}

enum TripActivityType {
  TRANSPORT
  VISIT
  MEAL
  ACCOMMODATION
  REST
  FREE_TIME
  OTHER
}

enum TripPriceCategory {
  TRANSPORT
  ACCOMMODATION
  FOOD
  TICKET
  ACTIVITY
  OTHER
}

enum TransportMode {
  MOTORBIKE
  PRIVATE_CAR
  TAXI_RIDE_HAILING
  BUS
  TRAIN
  AIRPLANE
  BOAT_FERRY
  BICYCLE
  WALKING
  OTHER
}

enum AccommodationType {
  HOTEL
  RESORT
  HOMESTAY
  HOSTEL
  APARTMENT
  GUESTHOUSE
  CAMPING
  OTHER
}

enum TripConstraintType {
  MOBILITY
  ACCESSIBILITY
  DIETARY
  SCHEDULE
  TRANSPORT
  ACCOMMODATION
  SAFETY
  OTHER
}

enum ConstraintPriority {
  PREFERENCE
  IMPORTANT
  REQUIRED
}

enum SavedPlacePriority {
  OPTIONAL
  PREFERRED
  REQUIRED
}

enum TripPlanGenerationStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum TripPlanAttemptStatus {
  STARTED
  SUCCEEDED
  FAILED
  TIMED_OUT
  CANCELLED
}

enum TripPlanVersionStatus {
  READY
  ACTIVE
  ARCHIVED
}

model User {
  id                          String               @id @db.Uuid
  email                       String?              @unique @db.VarChar(320)
  isActive                    Boolean              @default(true)
  lastLoginAt                 DateTime?            @db.Timestamptz(6)
  createdAt                   DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt                   DateTime             @updatedAt @db.Timestamptz(6)
  deletedAt                   DateTime?            @db.Timestamptz(6)
  profile                     UserProfile?
  consent                     UserConsent?
  preference                  UserPreference?
  ownedPartner                Partner?             @relation("PartnerOwner")
  reviewedPartners            Partner[]            @relation("PartnerReviewer")
  createdPlaces               Place[]              @relation("PlaceCreator")
  reviewedPlaces              Place[]              @relation("PlaceReviewer")
  ownedTrips                  Trip[]               @relation("TripOwner")
  requestedPlanGenerations    TripPlanGeneration[] @relation("TripPlanGenerationRequester")
  userRoles                   UserRole[]
  placeReviews                PlaceReview[]        @relation("PlaceReviewAuthor")
  submittedPlaceReviewReports PlaceReviewReport[]  @relation("PlaceReviewReportReporter")
  moderatedPlaceReviewReports PlaceReviewReport[]  @relation("PlaceReviewReportModerator")
  receivedNotifications       Notification[]       @relation("NotificationRecipient")
  triggeredNotifications      Notification[]       @relation("NotificationActor")
  auditLogs                   AuditLog[]           @relation("AuditLogActor")

  @@index([isActive])
  @@index([deletedAt])
  @@map("users")
}

model UserProfile {
  userId      String    @id @db.Uuid
  fullName    String?   @db.VarChar(150)
  displayName String?   @db.VarChar(80)
  avatarUrl   String?   @db.VarChar(2048)
  bio         String?   @db.VarChar(500)
  phone       String?   @db.VarChar(30)
  dateOfBirth DateTime? @db.Date
  city        String?   @db.VarChar(100)
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([displayName])
  @@index([city])
  @@map("user_profiles")
}

model UserConsent {
  userId                 String   @id @db.Uuid
  termsAccepted          Boolean  @default(false)
  privacyAccepted        Boolean  @default(false)
  locationConsent        Boolean  @default(false)
  personalizationConsent Boolean  @default(false)
  marketingConsent       Boolean  @default(false)
  createdAt              DateTime @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime @updatedAt @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_consents")
}

model UserPreference {
  userId                  String      @id @db.Uuid
  travelPace              TravelPace  @default(BALANCED)
  preferredTransports     String[]    @default([])
  preferredAccommodations String[]    @default([])
  preferredActivities     String[]    @default([])
  preferredDestinations   String[]    @default([])
  avoidedActivities       String[]    @default([])
  maximumWalkingDistance  Int?
  preferredStartTime      DateTime?   @db.Time(0)
  preferredEndTime        DateTime?   @db.Time(0)
  defaultBudgetLevel      BudgetLevel @default(STANDARD)
  dietaryNotes            String?     @db.VarChar(500)
  accessibilityNotes      String?     @db.VarChar(500)
  createdAt               DateTime    @default(now()) @db.Timestamptz(6)
  updatedAt               DateTime    @updatedAt @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

model Role {
  id              String           @id @default(uuid()) @db.Uuid
  name            AppRole          @unique
  description     String?          @db.VarChar(255)
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @db.Timestamptz(6)
  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@index([isActive])
  @@map("roles")
}

model Permission {
  id              String           @id @default(uuid()) @db.Uuid
  code            String           @unique @db.VarChar(100)
  name            String           @db.VarChar(150)
  description     String?          @db.VarChar(500)
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @db.Timestamptz(6)
  rolePermissions RolePermission[]

  @@index([isActive])
  @@map("permissions")
}

model UserRole {
  userId     String   @db.Uuid
  roleId     String   @db.Uuid
  assignedAt DateTime @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String   @db.Uuid
  permissionId String   @db.Uuid
  assignedAt   DateTime @default(now()) @db.Timestamptz(6)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model Partner {
  id                 String                @id @default(uuid()) @db.Uuid
  ownerUserId        String                @unique @db.Uuid
  reviewedByUserId   String?               @db.Uuid
  name               String                @db.VarChar(200)
  slug               String                @unique @db.VarChar(200)
  type               PartnerType
  description        String?               @db.VarChar(2000)
  logoUrl            String?               @db.VarChar(2048)
  phone              String?               @db.VarChar(30)
  email              String?               @db.VarChar(320)
  websiteUrl         String?               @db.VarChar(2048)
  taxCode            String?               @db.VarChar(50)
  businessLicenseUrl String?               @db.VarChar(2048)
  approvalStatus     PartnerApprovalStatus @default(NOT_APPLIED)
  rejectionReason    String?               @db.VarChar(1000)
  submittedAt        DateTime?             @db.Timestamptz(6)
  reviewedAt         DateTime?             @db.Timestamptz(6)
  createdAt          DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime              @updatedAt @db.Timestamptz(6)
  deletedAt          DateTime?             @db.Timestamptz(6)

  owner      User            @relation("PartnerOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  reviewedBy User?           @relation("PartnerReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  branches   PartnerBranch[]
  places     Place[]

  @@index([reviewedByUserId])
  @@index([type])
  @@index([approvalStatus])
  @@index([deletedAt])
  @@map("partners")
}

model PartnerBranch {
  id           String    @id @default(uuid()) @db.Uuid
  partnerId    String    @db.Uuid
  name         String    @db.VarChar(200)
  addressLine  String    @db.VarChar(255)
  ward         String?   @db.VarChar(100)
  district     String?   @db.VarChar(100)
  province     String    @db.VarChar(100)
  latitude     Decimal?  @db.Decimal(9, 6)
  longitude    Decimal?  @db.Decimal(10, 6)
  phone        String?   @db.VarChar(30)
  email        String?   @db.VarChar(320)
  isHeadOffice Boolean   @default(false)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt    DateTime? @db.Timestamptz(6)

  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  places  Place[]

  @@index([partnerId])
  @@index([province])
  @@index([isActive])
  @@index([deletedAt])
  @@map("partner_branches")
}

model Province {
  id        String     @id @default(uuid()) @db.Uuid
  code      String     @unique @db.VarChar(20)
  name      String     @db.VarChar(100)
  slug      String     @unique @db.VarChar(120)
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt DateTime   @updatedAt @db.Timestamptz(6)
  districts District[]
  places    Place[]
  trips     Trip[]

  @@index([name])
  @@index([isActive])
  @@map("provinces")
}

model District {
  id         String   @id @default(uuid()) @db.Uuid
  provinceId String   @db.Uuid
  code       String   @unique @db.VarChar(20)
  name       String   @db.VarChar(100)
  slug       String   @db.VarChar(120)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @db.Timestamptz(6)

  province Province @relation(fields: [provinceId], references: [id], onDelete: Restrict)
  places   Place[]
  trips    Trip[]

  @@unique([provinceId, slug])
  @@index([provinceId])
  @@index([name])
  @@index([isActive])
  @@map("districts")
}

model PlaceCategory {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(120)
  slug        String   @unique @db.VarChar(120)
  description String?  @db.VarChar(500)
  iconName    String?  @db.VarChar(100)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)
  places      Place[]

  @@index([name])
  @@index([isActive])
  @@map("place_categories")
}

model Place {
  id                 String                  @id @default(uuid()) @db.Uuid
  partnerId          String?                 @db.Uuid
  partnerBranchId    String?                 @db.Uuid
  categoryId         String                  @db.Uuid
  provinceId         String                  @db.Uuid
  districtId         String?                 @db.Uuid
  createdByUserId    String?                 @db.Uuid
  reviewedByUserId   String?                 @db.Uuid
  name               String                  @db.VarChar(200)
  slug               String                  @unique @db.VarChar(220)
  shortDescription   String?                 @db.VarChar(500)
  description        String?                 @db.VarChar(5000)
  addressLine        String                  @db.VarChar(255)
  ward               String?                 @db.VarChar(100)
  latitude           Decimal?                @db.Decimal(9, 6)
  longitude          Decimal?                @db.Decimal(10, 6)
  phone              String?                 @db.VarChar(30)
  email              String?                 @db.VarChar(320)
  websiteUrl         String?                 @db.VarChar(2048)
  verificationStatus PlaceVerificationStatus @default(DRAFT)
  rejectionReason    String?                 @db.VarChar(1000)
  submittedAt        DateTime?               @db.Timestamptz(6)
  reviewedAt         DateTime?               @db.Timestamptz(6)
  isActive           Boolean                 @default(true)
  createdAt          DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime                @updatedAt @db.Timestamptz(6)
  deletedAt          DateTime?               @db.Timestamptz(6)

  partner        Partner?           @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  partnerBranch  PartnerBranch?     @relation(fields: [partnerBranchId], references: [id], onDelete: SetNull)
  category       PlaceCategory      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  province       Province           @relation(fields: [provinceId], references: [id], onDelete: Restrict)
  district       District?          @relation(fields: [districtId], references: [id], onDelete: SetNull)
  createdBy      User?              @relation("PlaceCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  reviewedBy     User?              @relation("PlaceReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  images         PlaceImage[]
  openingHours   PlaceOpeningHour[]
  prices         PlacePrice[]
  tripActivities TripActivity[]
  savedInTrips   TripSavedPlace[]
  reviews        PlaceReview[]

  @@index([partnerId])
  @@index([partnerBranchId])
  @@index([categoryId])
  @@index([provinceId])
  @@index([districtId])
  @@index([createdByUserId])
  @@index([reviewedByUserId])
  @@index([verificationStatus])
  @@index([isActive])
  @@index([deletedAt])
  @@map("places")
}

model PlaceImage {
  id          String   @id @default(uuid()) @db.Uuid
  placeId     String   @db.Uuid
  storagePath String   @db.VarChar(1024)
  altText     String?  @db.VarChar(255)
  caption     String?  @db.VarChar(500)
  sortOrder   Int      @default(0)
  isCover     Boolean  @default(false)
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@index([placeId, sortOrder])
  @@index([placeId, isCover])
  @@map("place_images")
}

model PlaceOpeningHour {
  id            String    @id @default(uuid()) @db.Uuid
  placeId       String    @db.Uuid
  dayOfWeek     DayOfWeek
  periodOrder   Int       @default(1)
  openTime      DateTime? @db.Time(0)
  closeTime     DateTime? @db.Time(0)
  closesNextDay Boolean   @default(false)
  isClosed      Boolean   @default(false)
  isOpen24Hours Boolean   @default(false)
  note          String?   @db.VarChar(500)
  createdAt     DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(6)

  place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@unique([placeId, dayOfWeek, periodOrder])
  @@index([placeId])
  @@index([dayOfWeek])
  @@map("place_opening_hours")
}

model PlacePrice {
  id              String             @id @default(uuid()) @db.Uuid
  placeId         String             @db.Uuid
  label           String             @db.VarChar(150)
  audience        PlacePriceAudience @default(GENERAL)
  unit            PlacePriceUnit
  amount          Decimal            @db.Decimal(14, 2)
  currency        String             @default("VND") @db.VarChar(3)
  minimumQuantity Int?
  maximumQuantity Int?
  validFrom       DateTime?          @db.Date
  validUntil      DateTime?          @db.Date
  note            String?            @db.VarChar(1000)
  isActive        Boolean            @default(true)
  createdAt       DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime           @updatedAt @db.Timestamptz(6)

  place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@index([placeId])
  @@index([placeId, isActive])
  @@index([audience])
  @@index([validFrom, validUntil])
  @@map("place_prices")
}

model Trip {
  id                    String     @id @default(uuid()) @db.Uuid
  ownerUserId           String     @db.Uuid
  destinationProvinceId String?    @db.Uuid
  destinationDistrictId String?    @db.Uuid
  title                 String     @default("Chuyến đi mới") @db.VarChar(200)
  originName            String?    @db.VarChar(255)
  originLatitude        Decimal?   @db.Decimal(9, 6)
  originLongitude       Decimal?   @db.Decimal(10, 6)
  startDate             DateTime?  @db.Date
  endDate               DateTime?  @db.Date
  totalBudget           Decimal?   @db.Decimal(14, 2)
  currency              String     @default("VND") @db.VarChar(3)
  currentStep           Int        @default(1)
  status                TripStatus @default(DRAFT)
  notes                 String?    @db.VarChar(2000)
  createdAt             DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime   @updatedAt @db.Timestamptz(6)
  deletedAt             DateTime?  @db.Timestamptz(6)

  owner                   User                         @relation("TripOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  destinationProvince     Province?                    @relation(fields: [destinationProvinceId], references: [id], onDelete: SetNull)
  destinationDistrict     District?                    @relation(fields: [destinationDistrictId], references: [id], onDelete: SetNull)
  participants            TripParticipant[]
  days                    TripDay[]
  transportPreference     TripTransportPreference?
  accommodationPreference TripAccommodationPreference?
  preference              TripPreference?
  constraints             TripConstraint[]
  savedPlaces             TripSavedPlace[]
  planGenerations         TripPlanGeneration[]
  planVersions            TripPlanVersion[]
  checklists              TripChecklist[]
  managedBudget           TripBudget?
  expenseEntries          TripExpense[]

  @@index([ownerUserId])
  @@index([destinationProvinceId])
  @@index([destinationDistrictId])
  @@index([status])
  @@index([startDate, endDate])
  @@index([deletedAt])
  @@map("trips")
}

model TripParticipant {
  id          String              @id @default(uuid()) @db.Uuid
  tripId      String              @db.Uuid
  displayName String              @db.VarChar(150)
  ageGroup    ParticipantAgeGroup @default(ADULT)
  ageAtTrip   Int?
  sortOrder   Int                 @default(0)
  notes       String?             @db.VarChar(500)
  createdAt   DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime            @updatedAt @db.Timestamptz(6)

  trip                   Trip                   @relation(fields: [tripId], references: [id], onDelete: Cascade)
  prices                 TripParticipantPrice[]
  constraints            TripConstraint[]
  assignedChecklistItems TripChecklistItem[]
  personalExpenseEntries TripExpense[]

  @@index([tripId])
  @@index([tripId, sortOrder])
  @@index([ageGroup])
  @@map("trip_participants")
}

model TripDay {
  id        String   @id @default(uuid()) @db.Uuid
  tripId    String   @db.Uuid
  dayNumber Int
  date      DateTime @db.Date
  title     String?  @db.VarChar(200)
  notes     String?  @db.VarChar(1000)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  trip           Trip           @relation(fields: [tripId], references: [id], onDelete: Cascade)
  activities     TripActivity[]
  expenseEntries TripExpense[]

  @@unique([tripId, dayNumber])
  @@unique([tripId, date])
  @@index([tripId])
  @@index([date])
  @@map("trip_days")
}

model TripActivity {
  id          String           @id @default(uuid()) @db.Uuid
  tripDayId   String           @db.Uuid
  placeId     String?          @db.Uuid
  type        TripActivityType
  title       String           @db.VarChar(200)
  description String?          @db.VarChar(2000)
  startsAt    DateTime         @db.Timestamptz(6)
  endsAt      DateTime         @db.Timestamptz(6)
  sortOrder   Int              @default(0)
  notes       String?          @db.VarChar(1000)
  createdAt   DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @db.Timestamptz(6)

  tripDay        TripDay       @relation(fields: [tripDayId], references: [id], onDelete: Cascade)
  place          Place?        @relation(fields: [placeId], references: [id], onDelete: SetNull)
  expenseEntries TripExpense[]

  @@index([tripDayId])
  @@index([tripDayId, sortOrder])
  @@index([placeId])
  @@index([type])
  @@index([startsAt])
  @@map("trip_activities")
}

model TripParticipantPrice {
  id            String            @id @default(uuid()) @db.Uuid
  participantId String            @db.Uuid
  category      TripPriceCategory
  label         String            @db.VarChar(150)
  amount        Decimal           @db.Decimal(14, 2)
  currency      String            @default("VND") @db.VarChar(3)
  sortOrder     Int               @default(0)
  notes         String?           @db.VarChar(1000)
  createdAt     DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime          @updatedAt @db.Timestamptz(6)

  participant TripParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@index([participantId])
  @@index([participantId, sortOrder])
  @@index([category])
  @@map("trip_participant_prices")
}

model TripTransportPreference {
  id                          String          @id @default(uuid()) @db.Uuid
  tripId                      String          @unique @db.Uuid
  mainMode                    TransportMode?
  localModes                  TransportMode[] @default([])
  avoidModes                  TransportMode[] @default([])
  privateVehicleCapacity      Int?
  maxTravelMinutesPerLeg      Int?
  requiresAccessibleTransport Boolean         @default(false)
  notes                       String?         @db.VarChar(1000)
  createdAt                   DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt                   DateTime        @updatedAt @db.Timestamptz(6)

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([mainMode])
  @@map("trip_transport_preferences")
}

model TripAccommodationPreference {
  id                      String              @id @default(uuid()) @db.Uuid
  tripId                  String              @unique @db.Uuid
  preferredTypes          AccommodationType[] @default([])
  roomCount               Int?
  maxNightlyBudget        Decimal?            @db.Decimal(14, 2)
  currency                String              @default("VND") @db.VarChar(3)
  requiredAmenities       String[]            @default([])
  preferredAmenities      String[]            @default([])
  allowsSharedRoom        Boolean             @default(false)
  maxDistanceFromCenterKm Decimal?            @db.Decimal(8, 2)
  notes                   String?             @db.VarChar(1000)
  createdAt               DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt               DateTime            @updatedAt @db.Timestamptz(6)

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@map("trip_accommodation_preferences")
}

model TripPreference {
  id                    String      @id @default(uuid()) @db.Uuid
  tripId                String      @unique @db.Uuid
  pace                  TravelPace?
  preferredStartTime    DateTime?   @db.Time(0)
  preferredEndTime      DateTime?   @db.Time(0)
  maxActivitiesPerDay   Int?
  interests             String[]    @default([])
  avoidInterests        String[]    @default([])
  wantsLocalExperiences Boolean     @default(false)
  notes                 String?     @db.VarChar(1000)
  createdAt             DateTime    @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime    @updatedAt @db.Timestamptz(6)

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([pace])
  @@map("trip_preferences")
}

model TripConstraint {
  id            String             @id @default(uuid()) @db.Uuid
  tripId        String             @db.Uuid
  participantId String?            @db.Uuid
  type          TripConstraintType
  priority      ConstraintPriority @default(PREFERENCE)
  title         String             @db.VarChar(150)
  details       String?            @db.VarChar(1000)
  isActive      Boolean            @default(true)
  sortOrder     Int                @default(0)
  createdAt     DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime           @updatedAt @db.Timestamptz(6)

  trip        Trip             @relation(fields: [tripId], references: [id], onDelete: Cascade)
  participant TripParticipant? @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@index([tripId])
  @@index([tripId, sortOrder])
  @@index([participantId])
  @@index([type])
  @@index([priority])
  @@index([isActive])
  @@map("trip_constraints")
}

model TripSavedPlace {
  id        String             @id @default(uuid()) @db.Uuid
  tripId    String             @db.Uuid
  placeId   String             @db.Uuid
  priority  SavedPlacePriority @default(OPTIONAL)
  sortOrder Int                @default(0)
  notes     String?            @db.VarChar(1000)
  createdAt DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt DateTime           @updatedAt @db.Timestamptz(6)

  trip  Trip  @relation(fields: [tripId], references: [id], onDelete: Cascade)
  place Place @relation(fields: [placeId], references: [id], onDelete: Restrict)

  @@unique([tripId, placeId])
  @@index([tripId])
  @@index([tripId, priority, sortOrder])
  @@index([placeId])
  @@index([priority])
  @@map("trip_saved_places")
}

model TripPlanGeneration {
  id                 String                   @id @default(uuid()) @db.Uuid
  tripId             String                   @db.Uuid
  requestedByUserId  String?                  @db.Uuid
  status             TripPlanGenerationStatus @default(QUEUED)
  inputSchemaVersion String                   @db.VarChar(50)
  safeInputSnapshot  Json                     @db.JsonB
  inputHash          String                   @db.VarChar(64)
  completedAt        DateTime?                @db.Timestamptz(6)
  createdAt          DateTime                 @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime                 @updatedAt @db.Timestamptz(6)

  trip            Trip              @relation(fields: [tripId], references: [id], onDelete: Cascade)
  requestedBy     User?             @relation("TripPlanGenerationRequester", fields: [requestedByUserId], references: [id], onDelete: SetNull)
  attempts        TripPlanAttempt[]
  producedVersion TripPlanVersion?

  @@index([tripId])
  @@index([tripId, createdAt])
  @@index([requestedByUserId])
  @@index([status])
  @@map("trip_plan_generations")
}

model TripPlanAttempt {
  id                String                @id @default(uuid()) @db.Uuid
  generationId      String                @db.Uuid
  attemptNumber     Int
  provider          String                @db.VarChar(100)
  model             String                @db.VarChar(150)
  status            TripPlanAttemptStatus @default(STARTED)
  isFallback        Boolean               @default(false)
  providerRequestId String?               @db.VarChar(255)
  inputTokens       Int?
  outputTokens      Int?
  estimatedCost     Decimal?              @db.Decimal(14, 6)
  costCurrency      String                @default("USD") @db.VarChar(3)
  latencyMs         Int?
  finishReason      String?               @db.VarChar(100)
  outputHash        String?               @db.VarChar(64)
  validationData    Json?                 @db.JsonB
  errorCode         String?               @db.VarChar(100)
  errorMessage      String?               @db.VarChar(1000)
  startedAt         DateTime              @default(now()) @db.Timestamptz(6)
  completedAt       DateTime?             @db.Timestamptz(6)
  createdAt         DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime              @updatedAt @db.Timestamptz(6)

  generation      TripPlanGeneration @relation(fields: [generationId], references: [id], onDelete: Cascade)
  producedVersion TripPlanVersion?

  @@unique([generationId, attemptNumber])
  @@index([generationId])
  @@index([status])
  @@index([provider, model])
  @@index([providerRequestId])
  @@index([createdAt])
  @@map("trip_plan_attempts")
}

model TripPlanVersion {
  id                 String                @id @default(uuid()) @db.Uuid
  tripId             String                @db.Uuid
  generationId       String?               @unique @db.Uuid
  sourceAttemptId    String?               @unique @db.Uuid
  versionNumber      Int
  status             TripPlanVersionStatus @default(READY)
  schemaVersion      String                @db.VarChar(50)
  planData           Json                  @db.JsonB
  summaryData        Json?                 @db.JsonB
  validationData     Json                  @db.JsonB
  totalDays          Int
  totalActivities    Int
  estimatedTotalCost Decimal?              @db.Decimal(14, 2)
  currency           String                @default("VND") @db.VarChar(3)
  activatedAt        DateTime?             @db.Timestamptz(6)
  createdAt          DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime              @updatedAt @db.Timestamptz(6)

  trip          Trip                @relation(fields: [tripId], references: [id], onDelete: Cascade)
  generation    TripPlanGeneration? @relation(fields: [generationId], references: [id], onDelete: SetNull)
  sourceAttempt TripPlanAttempt?    @relation(fields: [sourceAttemptId], references: [id], onDelete: SetNull)

  @@unique([tripId, versionNumber])
  @@index([tripId])
  @@index([tripId, status])
  @@index([status])
  @@index([createdAt])
  @@map("trip_plan_versions")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String?  @db.Uuid
  action      String   @db.VarChar(100)
  entityType  String   @db.VarChar(100)
  entityId    String?  @db.VarChar(100)
  metadata    Json?    @db.JsonB
  createdAt   DateTime @default(now()) @db.Timestamptz(6)

  actor User? @relation("AuditLogActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId])
  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

enum TripChecklistPhase {
  BEFORE_TRIP
  DURING_TRIP
  AFTER_TRIP
}

enum TripChecklistSource {
  DEFAULT
  AI
  USER
}

enum TripChecklistItemStatus {
  TODO
  COMPLETED
  SKIPPED
}

enum TripExpenseCategory {
  TRANSPORTATION
  ACCOMMODATION
  FOOD
  TICKET
  ACTIVITY
  SHOPPING
  HEALTH
  EMERGENCY
  OTHER
}

enum TripExpenseScope {
  SHARED
  PERSONAL
}

enum TripExpenseSource {
  PLAN
  USER
}

model TripChecklist {
  id        String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tripId    String              @db.Uuid
  title     String              @db.VarChar(200)
  phase     TripChecklistPhase
  source    TripChecklistSource @default(USER)
  sortOrder Int                 @default(0)
  createdAt DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt DateTime            @updatedAt @db.Timestamptz(6)

  trip  Trip                @relation(fields: [tripId], references: [id], onDelete: Cascade)
  items TripChecklistItem[]

  @@index([tripId])
  @@index([tripId, phase, sortOrder])
  @@map("trip_checklists")
}

model TripChecklistItem {
  id                    String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  checklistId           String                  @db.Uuid
  assignedParticipantId String?                 @db.Uuid
  title                 String                  @db.VarChar(300)
  note                  String?                 @db.VarChar(1000)
  status                TripChecklistItemStatus @default(TODO)
  dueAt                 DateTime?               @db.Timestamptz(6)
  sortOrder             Int                     @default(0)
  completedAt           DateTime?               @db.Timestamptz(6)
  createdAt             DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime                @updatedAt @db.Timestamptz(6)

  checklist           TripChecklist    @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  assignedParticipant TripParticipant? @relation(fields: [assignedParticipantId], references: [id], onDelete: SetNull)

  @@index([checklistId])
  @@index([assignedParticipantId])
  @@index([checklistId, status])
  @@index([checklistId, sortOrder])
  @@map("trip_checklist_items")
}

model TripBudget {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tripId            String   @unique @db.Uuid
  plannedAmount     Decimal  @default(0) @db.Decimal(14, 2)
  contingencyAmount Decimal  @default(0) @db.Decimal(14, 2)
  currency          String   @default("VND") @db.VarChar(3)
  createdAt         DateTime @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @db.Timestamptz(6)

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@map("trip_budgets")
}

model TripExpense {
  id              String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tripId          String              @db.Uuid
  tripDayId       String?             @db.Uuid
  tripActivityId  String?             @db.Uuid
  participantId   String?             @db.Uuid
  title           String              @db.VarChar(200)
  category        TripExpenseCategory
  scope           TripExpenseScope    @default(SHARED)
  source          TripExpenseSource   @default(USER)
  estimatedAmount Decimal?            @db.Decimal(14, 2)
  actualAmount    Decimal?            @db.Decimal(14, 2)
  occurredAt      DateTime?           @db.Timestamptz(6)
  note            String?             @db.VarChar(1000)
  createdAt       DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime            @updatedAt @db.Timestamptz(6)

  trip         Trip             @relation(fields: [tripId], references: [id], onDelete: Cascade)
  tripDay      TripDay?         @relation(fields: [tripDayId], references: [id], onDelete: SetNull)
  tripActivity TripActivity?    @relation(fields: [tripActivityId], references: [id], onDelete: SetNull)
  participant  TripParticipant? @relation(fields: [participantId], references: [id], onDelete: Restrict)

  @@index([tripId])
  @@index([tripDayId])
  @@index([tripActivityId])
  @@index([participantId])
  @@index([tripId, category])
  @@index([tripId, scope])
  @@index([tripId, source])
  @@index([occurredAt])
  @@map("trip_expenses")
}

enum RoadsideVehicleType {
  MOTORBIKE
  CAR
  BOTH
}

enum PlaceReviewStatus {
  PUBLISHED
  HIDDEN
}

enum PlaceReviewReportReason {
  SPAM
  ABUSIVE_OR_HARASSING
  HATE_OR_DISCRIMINATION
  INAPPROPRIATE_CONTENT
  MISLEADING_INFORMATION
  PRIVACY_VIOLATION
  CONFLICT_OF_INTEREST
  OTHER
}

enum PlaceReviewReportStatus {
  PENDING
  IN_REVIEW
  RESOLVED
  DISMISSED
}

enum NotificationCategory {
  SYSTEM
  TRIP
  PLACE
  REVIEW
  REPORT
  PARTNER
  SECURITY
  VOUCHER
  SOCIAL
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model RoadsideAssistanceContact {
  id            String              @id @default(uuid()) @db.Uuid
  name          String              @db.VarChar(200)
  phone         String              @db.VarChar(30)
  vehicleType   RoadsideVehicleType
  areaName      String              @db.VarChar(200)
  googleMapsUrl String              @db.VarChar(2048)
  displayOrder  Int                 @default(0)
  isActive      Boolean             @default(true)
  createdAt     DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime            @updatedAt @db.Timestamptz(6)

  @@index([isActive, displayOrder])
  @@index([areaName])
  @@index([vehicleType])
  @@map("roadside_assistance_contacts")
}

model PlaceReview {
  id             String            @id @default(uuid()) @db.Uuid
  userId         String            @db.Uuid
  placeId        String            @db.Uuid
  rating         Int
  content        String?           @db.VarChar(2000)
  status         PlaceReviewStatus @default(PUBLISHED)
  moderationNote String?           @db.VarChar(500)
  createdAt      DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime          @updatedAt @db.Timestamptz(6)

  author  User                @relation("PlaceReviewAuthor", fields: [userId], references: [id], onDelete: Cascade)
  place   Place               @relation(fields: [placeId], references: [id], onDelete: Cascade)
  reports PlaceReviewReport[]

  @@unique([userId, placeId])
  @@index([placeId, status, createdAt])
  @@index([userId, createdAt])
  @@index([rating])
  @@map("place_reviews")
}

model PlaceReviewReport {
  id               String                  @id @default(uuid()) @db.Uuid
  reporterUserId   String?                 @db.Uuid
  placeReviewId    String                  @db.Uuid
  reason           PlaceReviewReportReason
  details          String?                 @db.VarChar(1000)
  status           PlaceReviewReportStatus @default(PENDING)
  reviewedByUserId String?                 @db.Uuid
  resolutionNote   String?                 @db.VarChar(1000)
  reviewedAt       DateTime?               @db.Timestamptz(6)
  resolvedAt       DateTime?               @db.Timestamptz(6)
  createdAt        DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime                @updatedAt @db.Timestamptz(6)

  reporter    User?       @relation("PlaceReviewReportReporter", fields: [reporterUserId], references: [id], onDelete: SetNull)
  placeReview PlaceReview @relation(fields: [placeReviewId], references: [id], onDelete: Restrict)
  reviewedBy  User?       @relation("PlaceReviewReportModerator", fields: [reviewedByUserId], references: [id], onDelete: Restrict)

  @@unique([reporterUserId, placeReviewId])
  @@index([placeReviewId, status, createdAt])
  @@index([reporterUserId, createdAt])
  @@index([status, createdAt])
  @@index([reviewedByUserId, status])
  @@map("place_review_reports")
}

model Notification {
  id               String               @id @default(uuid()) @db.Uuid
  recipientUserId  String               @db.Uuid
  actorUserId      String?              @db.Uuid
  category         NotificationCategory
  eventKey         String               @db.VarChar(100)
  priority         NotificationPriority @default(NORMAL)
  title            String               @db.VarChar(200)
  message          String               @db.VarChar(1000)
  actionUrl        String?              @db.VarChar(2048)
  metadata         Json?                @db.JsonB
  deduplicationKey String?              @db.VarChar(255)
  readAt           DateTime?            @db.Timestamptz(6)
  expiresAt        DateTime?            @db.Timestamptz(6)
  createdAt        DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime             @updatedAt @db.Timestamptz(6)

  recipient User  @relation("NotificationRecipient", fields: [recipientUserId], references: [id], onDelete: Cascade)
  actor     User? @relation("NotificationActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@unique([recipientUserId, deduplicationKey])
  @@index([recipientUserId, readAt, createdAt])
  @@index([recipientUserId, category, createdAt])
  @@index([expiresAt])
  @@index([actorUserId, createdAt])
  @@map("notifications")
}
