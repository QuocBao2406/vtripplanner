generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AppRole {
  USER
  PARTNER
  ADMIN
}

enum PartnerApprovalStatus {
  NOT_APPLIED
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum PartnerType {
  HOTEL
  HOMESTAY
  RESORT
  RESTAURANT
  EATERY
  CAFE
  ENTERTAINMENT_VENUE
  TOURIST_ATTRACTION
  TRANSPORT_PROVIDER
  RESCUE_SERVICE
  VEHICLE_REPAIR
  TRAVEL_SERVICE
  OTHER
}

enum PlaceVerificationStatus {
  DRAFT
  PENDING
  VERIFIED
  REJECTED
  SUSPENDED
}

enum TravelPace {
  RELAXED
  BALANCED
  ACTIVE
}

enum BudgetLevel {
  ECONOMY
  STANDARD
  PREMIUM
}

model User {
  id               String          @id @db.Uuid
  email            String?         @unique @db.VarChar(320)
  isActive         Boolean         @default(true)
  lastLoginAt      DateTime?       @db.Timestamptz(6)
  createdAt        DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime        @updatedAt @db.Timestamptz(6)
  deletedAt        DateTime?       @db.Timestamptz(6)
  profile          UserProfile?
  consent          UserConsent?
  preference       UserPreference?
  ownedPartner     Partner?        @relation("PartnerOwner")
  reviewedPartners Partner[]       @relation("PartnerReviewer")
  createdPlaces    Place[]         @relation("PlaceCreator")
  reviewedPlaces   Place[]         @relation("PlaceReviewer")
  userRoles        UserRole[]
  auditLogs        AuditLog[]      @relation("AuditLogActor")

  @@index([isActive])
  @@index([deletedAt])
  @@map("users")
}

model UserProfile {
  userId      String    @id @db.Uuid
  fullName    String?   @db.VarChar(150)
  displayName String?   @db.VarChar(80)
  avatarUrl   String?   @db.VarChar(2048)
  bio         String?   @db.VarChar(500)
  phone       String?   @db.VarChar(30)
  dateOfBirth DateTime? @db.Date
  city        String?   @db.VarChar(100)
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([displayName])
  @@index([city])
  @@map("user_profiles")
}

model UserConsent {
  userId                 String   @id @db.Uuid
  termsAccepted          Boolean  @default(false)
  privacyAccepted        Boolean  @default(false)
  locationConsent        Boolean  @default(false)
  personalizationConsent Boolean  @default(false)
  marketingConsent       Boolean  @default(false)
  createdAt              DateTime @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime @updatedAt @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_consents")
}

model UserPreference {
  userId                  String      @id @db.Uuid
  travelPace              TravelPace  @default(BALANCED)
  preferredTransports     String[]    @default([])
  preferredAccommodations String[]    @default([])
  preferredActivities     String[]    @default([])
  preferredDestinations   String[]    @default([])
  avoidedActivities       String[]    @default([])
  maximumWalkingDistance  Int?
  preferredStartTime      DateTime?   @db.Time(0)
  preferredEndTime        DateTime?   @db.Time(0)
  defaultBudgetLevel      BudgetLevel @default(STANDARD)
  dietaryNotes            String?     @db.VarChar(500)
  accessibilityNotes      String?     @db.VarChar(500)
  createdAt               DateTime    @default(now()) @db.Timestamptz(6)
  updatedAt               DateTime    @updatedAt @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

model Role {
  id              String           @id @default(uuid()) @db.Uuid
  name            AppRole          @unique
  description     String?          @db.VarChar(255)
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @db.Timestamptz(6)
  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@index([isActive])
  @@map("roles")
}

model Permission {
  id              String           @id @default(uuid()) @db.Uuid
  code            String           @unique @db.VarChar(100)
  name            String           @db.VarChar(150)
  description     String?          @db.VarChar(500)
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @db.Timestamptz(6)
  rolePermissions RolePermission[]

  @@index([isActive])
  @@map("permissions")
}

model UserRole {
  userId     String   @db.Uuid
  roleId     String   @db.Uuid
  assignedAt DateTime @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String   @db.Uuid
  permissionId String   @db.Uuid
  assignedAt   DateTime @default(now()) @db.Timestamptz(6)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model Partner {
  id                 String                @id @default(uuid()) @db.Uuid
  ownerUserId        String                @unique @db.Uuid
  reviewedByUserId   String?               @db.Uuid
  name               String                @db.VarChar(200)
  slug               String                @unique @db.VarChar(200)
  type               PartnerType
  description        String?               @db.VarChar(2000)
  logoUrl            String?               @db.VarChar(2048)
  phone              String?               @db.VarChar(30)
  email              String?               @db.VarChar(320)
  websiteUrl         String?               @db.VarChar(2048)
  taxCode            String?               @db.VarChar(50)
  businessLicenseUrl String?               @db.VarChar(2048)
  approvalStatus     PartnerApprovalStatus @default(NOT_APPLIED)
  rejectionReason    String?               @db.VarChar(1000)
  submittedAt        DateTime?             @db.Timestamptz(6)
  reviewedAt         DateTime?             @db.Timestamptz(6)
  createdAt          DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime              @updatedAt @db.Timestamptz(6)
  deletedAt          DateTime?             @db.Timestamptz(6)

  owner      User            @relation("PartnerOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  reviewedBy User?           @relation("PartnerReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  branches   PartnerBranch[]
  places     Place[]

  @@index([reviewedByUserId])
  @@index([type])
  @@index([approvalStatus])
  @@index([deletedAt])
  @@map("partners")
}

model PartnerBranch {
  id           String    @id @default(uuid()) @db.Uuid
  partnerId    String    @db.Uuid
  name         String    @db.VarChar(200)
  addressLine  String    @db.VarChar(255)
  ward         String?   @db.VarChar(100)
  district     String?   @db.VarChar(100)
  province     String    @db.VarChar(100)
  latitude     Decimal?  @db.Decimal(9, 6)
  longitude    Decimal?  @db.Decimal(10, 6)
  phone        String?   @db.VarChar(30)
  email        String?   @db.VarChar(320)
  isHeadOffice Boolean   @default(false)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt    DateTime? @db.Timestamptz(6)

  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  places  Place[]

  @@index([partnerId])
  @@index([province])
  @@index([isActive])
  @@index([deletedAt])
  @@map("partner_branches")
}

model Province {
  id        String     @id @default(uuid()) @db.Uuid
  code      String     @unique @db.VarChar(20)
  name      String     @db.VarChar(100)
  slug      String     @unique @db.VarChar(120)
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt DateTime   @updatedAt @db.Timestamptz(6)
  districts District[]
  places    Place[]

  @@index([name])
  @@index([isActive])
  @@map("provinces")
}

model District {
  id         String   @id @default(uuid()) @db.Uuid
  provinceId String   @db.Uuid
  code       String   @unique @db.VarChar(20)
  name       String   @db.VarChar(100)
  slug       String   @db.VarChar(120)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @db.Timestamptz(6)

  province Province @relation(fields: [provinceId], references: [id], onDelete: Restrict)
  places   Place[]

  @@unique([provinceId, slug])
  @@index([provinceId])
  @@index([name])
  @@index([isActive])
  @@map("districts")
}

model PlaceCategory {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(120)
  slug        String   @unique @db.VarChar(120)
  description String?  @db.VarChar(500)
  iconName    String?  @db.VarChar(100)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)
  places      Place[]

  @@index([name])
  @@index([isActive])
  @@map("place_categories")
}

model Place {
  id                 String                  @id @default(uuid()) @db.Uuid
  partnerId          String?                 @db.Uuid
  partnerBranchId    String?                 @db.Uuid
  categoryId         String                  @db.Uuid
  provinceId         String                  @db.Uuid
  districtId         String?                 @db.Uuid
  createdByUserId    String?                 @db.Uuid
  reviewedByUserId   String?                 @db.Uuid
  name               String                  @db.VarChar(200)
  slug               String                  @unique @db.VarChar(220)
  shortDescription   String?                 @db.VarChar(500)
  description        String?                 @db.VarChar(5000)
  addressLine        String                  @db.VarChar(255)
  ward               String?                 @db.VarChar(100)
  latitude           Decimal?                @db.Decimal(9, 6)
  longitude          Decimal?                @db.Decimal(10, 6)
  phone              String?                 @db.VarChar(30)
  email              String?                 @db.VarChar(320)
  websiteUrl         String?                 @db.VarChar(2048)
  verificationStatus PlaceVerificationStatus @default(DRAFT)
  rejectionReason    String?                 @db.VarChar(1000)
  submittedAt        DateTime?               @db.Timestamptz(6)
  reviewedAt         DateTime?               @db.Timestamptz(6)
  isActive           Boolean                 @default(true)
  createdAt          DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime                @updatedAt @db.Timestamptz(6)
  deletedAt          DateTime?               @db.Timestamptz(6)

  partner       Partner?       @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  partnerBranch PartnerBranch? @relation(fields: [partnerBranchId], references: [id], onDelete: SetNull)
  category      PlaceCategory  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  province      Province       @relation(fields: [provinceId], references: [id], onDelete: Restrict)
  district      District?      @relation(fields: [districtId], references: [id], onDelete: SetNull)
  createdBy     User?          @relation("PlaceCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  reviewedBy    User?          @relation("PlaceReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@index([partnerId])
  @@index([partnerBranchId])
  @@index([categoryId])
  @@index([provinceId])
  @@index([districtId])
  @@index([createdByUserId])
  @@index([reviewedByUserId])
  @@index([verificationStatus])
  @@index([isActive])
  @@index([deletedAt])
  @@map("places")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String?  @db.Uuid
  action      String   @db.VarChar(100)
  entityType  String   @db.VarChar(100)
  entityId    String?  @db.VarChar(100)
  metadata    Json?    @db.JsonB
  createdAt   DateTime @default(now()) @db.Timestamptz(6)

  actor User? @relation("AuditLogActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId])
  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}
